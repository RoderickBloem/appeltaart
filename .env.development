# Local development runs against the Firebase emulators. A project id starting
# with "demo-" tells the emulators no real project exists, so no keys are needed.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-appeltaart.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-appeltaart
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATORS=true
