{
  "name": "appeltaart",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-appeltaart",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-appeltaart \"playwright test\"",
    "icons": "node scripts/render-icons.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "firebase-tools": "^15.34.1",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
