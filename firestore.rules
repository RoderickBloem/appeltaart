rules_version = '2';

// One shared document, lists/{householdId}, holds the people who use the
// app (`members`, their names in `memberNames`), invitations, and learned
// products; its own `items` are the main list, which everyone sees. (It is
// in `lists/` because it began as the only list; src/household.ts.)
// Further lists are lists/{householdId}/lists/{listId}, each with its items
// under it and a `visibleTo` map of the members who see it.
//
// No client creates the shared document. Any member can invite someone by
// adding their address to `invites`; the invited person's app then adds them
// to `members` when they sign in with that address. Nobody can add anyone
// else, so someone without an invitation gets no data at all.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Lower case; for Gmail also without dots and +suffix, as Gmail delivers
    // j.doe+shop@gmail.com to jdoe@gmail.com. Same as normaliseEmail() in
    // src/list.ts.
    function normaliseEmail(email) {
      let lower = email.lower();
      let parts = lower.split('@');
      let gmail = parts.size() == 2 && parts[1] in ['gmail.com', 'googlemail.com'];
      return gmail ? parts[0].split('[+]')[0].replace('[.]', '') + '@gmail.com' : lower;
    }

    function myEmail() {
      return normaliseEmail(request.auth.token.email);
    }

    match /lists/{householdId} {
      function isMember() {
        return request.auth.uid in resource.data.members;
      }

      function isInvited() {
        return request.auth.token.email_verified == true
          && myEmail() in resource.data.get('invites', []);
      }

      function changes() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // `memberNames` maps uids to display names; each person sets only their own.
      function ownNameOnly() {
        return request.resource.data.get('memberNames', {})
          .diff(resource.data.get('memberNames', {})).affectedKeys().hasOnly([request.auth.uid]);
      }

      // The app finds the shared document with where('members.<uid>', '==', true)
      // and its invitations with where('invites', 'array-contains', <own address>).
      allow read: if signedIn() && (isMember() || isInvited());
      // Members may invite or withdraw invitations, and set their own name.
      // `invites` holds normalised addresses; `invitedAs` the same as typed.
      allow update: if signedIn() && isMember()
        && changes().hasOnly(['invites', 'invitedAs', 'memberNames'])
        && ownNameOnly()
        && request.resource.data.get('invites', []) is list
        && request.resource.data.get('invites', []).size() <= 50;
      // An invited person joins: adds exactly themselves to `members`, may
      // record their own name, and removes exactly their own invitation.
      allow update: if signedIn() && isInvited()
        && changes().hasOnly(['members', 'memberNames', 'invites'])
        && ownNameOnly()
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true
        && request.resource.data.invites.toSet() == resource.data.invites.toSet().difference([myEmail()].toSet());

      function household() {
        return get(/databases/$(database)/documents/lists/$(householdId)).data;
      }

      function inHousehold() {
        return signedIn() && request.auth.uid in household().members;
      }

      // The main list. No client deletes an item outright; a delete sets
      // `deletedAt`, and tombstones are purged with admin rights.
      match /items/{itemId} {
        allow read, create, update: if inHousehold();
      }

      // What the household has learned about each product, such as its category.
      match /products/{productId} {
        allow read, create, update: if inHousehold();
      }

      match /lists/{listId} {
        // Who sees a list: members of the household only, always including
        // the person making the change, so nobody locks themselves out.
        function validVisibleTo() {
          let visibleTo = request.resource.data.visibleTo;
          return visibleTo.keys().hasOnly(household().members.keys())
            && visibleTo[request.auth.uid] == true;
        }

        // The app lists them with where('visibleTo.<uid>', '==', true).
        allow read: if inHousehold() && request.auth.uid in resource.data.visibleTo;
        allow create: if inHousehold()
          && request.resource.data.keys().hasOnly(['name', 'visibleTo', 'createdAt', 'createdBy'])
          && validVisibleTo();
        allow update: if inHousehold()
          && request.auth.uid in resource.data.visibleTo
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'visibleTo', 'deletedAt'])
          && validVisibleTo();

        match /items/{itemId} {
          allow read, create, update: if inHousehold()
            && request.auth.uid in get(/databases/$(database)/documents/lists/$(householdId)/lists/$(listId)).data.visibleTo;
        }
      }
    }
  }
}
