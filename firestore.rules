rules_version = '2';

// A list is shared by the uids in its `members` map. Every user's app creates
// lists/{uid} for them on first sign-in. Any member can invite someone by
// adding their address to `invites`; the invited person's app then adds them
// to `members` when they sign in with that address. Nobody can add anyone
// else to `members`, so a list is only ever joined by invitation.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Lower case; for Gmail also without dots and +suffix, as Gmail delivers
    // j.doe+shop@gmail.com to jdoe@gmail.com. Same as normaliseEmail() in
    // src/list.ts.
    function normaliseEmail(email) {
      let lower = email.lower();
      let parts = lower.split('@');
      let gmail = parts.size() == 2 && parts[1] in ['gmail.com', 'googlemail.com'];
      return gmail ? parts[0].split('[+]')[0].replace('[.]', '') + '@gmail.com' : lower;
    }

    function myEmail() {
      return normaliseEmail(request.auth.token.email);
    }

    match /lists/{listId} {
      function isMember() {
        return request.auth.uid in resource.data.members;
      }

      function isInvited() {
        return request.auth.token.email_verified == true
          && myEmail() in resource.data.get('invites', []);
      }

      function changes() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // `resource == null` lets the app ask whether its list exists yet. The
      // app finds its lists with where('members.<uid>', '==', true) and its
      // invitations with where('invites', 'array-contains', <own address>).
      allow read: if signedIn() && (resource == null || isMember() || isInvited());
      allow create: if signedIn()
        && listId == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.get('invites', []).size() == 0;
      // Members may rename the list and invite or withdraw invitations.
      // `invites` holds normalised addresses; `invitedAs` the same as typed.
      allow update: if signedIn() && isMember()
        && changes().hasOnly(['name', 'invites', 'invitedAs'])
        && request.resource.data.get('invites', []) is list
        && request.resource.data.get('invites', []).size() <= 50;
      // An invited person joins: adds exactly themselves to `members` and
      // removes exactly their own invitation.
      allow update: if signedIn() && isInvited()
        && changes().hasOnly(['members', 'invites'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true
        && request.resource.data.invites.toSet() == resource.data.invites.toSet().difference([myEmail()].toSet());

      // The owner is let in by uid, without reading the list document: the
      // app starts its item listener and writes before that document reaches
      // the server, and a rule that needs it would reject them. No client
      // deletes an item outright; a delete sets `deletedAt`, and tombstones
      // are purged with admin rights.
      match /items/{itemId} {
        allow read, create, update: if signedIn()
          && (listId == request.auth.uid
            || request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.members);
      }
    }
  }
}
